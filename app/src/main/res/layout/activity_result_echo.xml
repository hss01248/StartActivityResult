<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:text="选择一种回传方式，验证 forkIntent 是否丢字段" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="returnFullIntent"
        android:text="返回完整 Intent(含 ClipData/Extras)"
        android:textAllCaps="false" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="returnEmptyIntent"
        android:text="返回空 Intent(非 null)"
        android:textAllCaps="false" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="returnCancelNull"
        android:text="取消(RESULT_CANCELED + data=null)"
        android:textAllCaps="false" />
</LinearLayout>
